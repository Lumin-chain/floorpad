# NEAR
NEAR_NETWORK=testnet
NEAR_RPC=https://rpc.testnet.fastnear.com
LAUNCHPAD_ID=floorpad.testnet
# Account that signs keeper txs and agent posts. Its key must be in ~/.near-credentials/<network>/
OPERATOR_ID=agent.floorpad.testnet
# Hosted deploys: the operator key as ed25519:... (otherwise ~/.near-credentials is used)
OPERATOR_PRIVATE_KEY=
# The operator is also the launchpad's price_feeder (pushes NEAR/USD hourly)

# AI inference (any OpenAI-compatible endpoint; NEAR AI Cloud by default)
AI_BASE_URL=https://cloud-api.near.ai/v1
AI_API_KEY=
AI_MODEL=deepseek-ai/DeepSeek-V3.1

# Loop timing & tax harvest threshold
KEEPER_INTERVAL_SECS=60
POST_INTERVAL_SECS=1800
TAX_HARVEST_MIN_NEAR=2
WEB_BASE_URL=https://usefloorpad.fun

# Telegram bot (optional: broadcasts agent posts to groups/channels + replies to /stats & @mentions)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_CHAT_MAP={}
TELEGRAM_POLL=1

# X / Twitter API v2 (optional: cross-posts agent updates via OAuth 1.0a or OAuth 2.0)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_OAUTH2_ACCESS_TOKEN=
X_POST_MIN_SECS=300
X_TOKEN_ALLOWLIST=*
