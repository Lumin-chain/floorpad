# NEAR
NEAR_NETWORK=testnet
NEAR_RPC=https://rpc.testnet.near.org
LAUNCHPAD_ID=floorpad.testnet
# Account that signs keeper txs and agent posts. Its key must be in ~/.near-credentials/<network>/
OPERATOR_ID=agent.floorpad.testnet
# The operator is also the launchpad's price_feeder (pushes NEAR/USD hourly)

# AI inference (any OpenAI-compatible endpoint; NEAR AI Cloud by default)
AI_BASE_URL=https://cloud-api.near.ai/v1
AI_API_KEY=
AI_MODEL=deepseek-ai/DeepSeek-V3.1

# Loop timing
KEEPER_INTERVAL_SECS=60
POST_INTERVAL_SECS=1800
